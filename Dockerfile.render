FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_MODE=api
ARG VITE_SUPPORT_EMAIL=youssoufchaiboabakaradam@gmail.com
ARG VITE_SUPPORT_WHATSAPP=23566009695
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CHAIBO_RENDER=1
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 10001 --create-home chaibo
COPY --chown=chaibo:chaibo backend/ ./
COPY --chown=chaibo:chaibo --from=frontend /build/dist /app/frontend_dist
COPY --chown=chaibo:chaibo deploy/render-start.sh /app/render-start.sh
RUN mkdir -p /app/staticfiles && chown chaibo:chaibo /app/staticfiles && chmod 755 /app/render-start.sh
USER chaibo
EXPOSE 10000
CMD ["sh", "/app/render-start.sh"]
