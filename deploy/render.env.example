# Copier uniquement les NOMS de variables dans Render, puis leurs vraies valeurs privées.
DJANGO_SECRET_KEY=GENERER_UN_SECRET_ALEATOIRE_64_CARACTERES_OU_PLUS
DJANGO_DEBUG=0
# Supabase > Connect > Session pooler (IPv4), port 5432.
POSTGRES_HOST=aws-0-votre-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.REFERENCE_DU_PROJET
POSTGRES_PASSWORD=MOT_DE_PASSE_DE_LA_BASE_SUPABASE
POSTGRES_SSLMODE=require
# Version simplifiée : pas de stockage de photos ni de fournisseur de messagerie.
CHAIBO_PHOTOS_ENABLED=0
CHAIBO_MESSAGING_ENABLED=0
# MEDIA_STORAGE et les variables S3/Brevo sont facultatifs tant que ces fonctions sont désactivées.
# Initialisation facultative, uniquement au premier démarrage. Retirer ces variables après création.
BOOTSTRAP_ADMIN_PHONE=VOTRE_NUMERO_ADMIN_AU_FORMAT_INTERNATIONAL
BOOTSTRAP_ADMIN_PASSWORD=VOTRE_MOT_DE_PASSE_INITIAL_FORT
BOOTSTRAP_ADMIN_NAME=Administrateur
BOOTSTRAP_ADMIN_EMAIL=VOTRE_EMAIL_ADMIN
